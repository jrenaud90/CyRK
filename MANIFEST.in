# MANIFEST.in

# Exclude all c++ and c files; we will manually add back in some custom ones.
# This avoids shipping already cythonized c files that need to be cythonized locally.
global-exclude *.c
global-exclude *.cpp
global-exclude *.h
global-exclude *.hpp

# Include Cython pyx and pxd files
global-include *.pxd
global-include *.pyx
include cython_extensions.json

# Include required hpp and cpp files
include CyRK/array/interp_common.c

include CyRK/cy/c_common.cpp
include CyRK/cy/c_common.hpp
include CyRK/cy/c_events.cpp
include CyRK/cy/c_events.hpp
include CyRK/cy/cysolver.cpp
include CyRK/cy/cysolver.hpp
include CyRK/cy/rk.cpp
include CyRK/cy/rk.hpp
include CyRK/cy/bdf.cpp
include CyRK/cy/bdf.hpp
include CyRK/cy/lsoda.cpp
include CyRK/cy/lsoda.hpp
include CyRK/cy/c_lsoda.cpp
include CyRK/cy/c_lsoda.hpp
include CyRK/cy/radau.cpp
include CyRK/cy/radau.hpp
include CyRK/cy/c_lu.cpp
include CyRK/cy/c_lu.hpp
include CyRK/cy/cysolve.cpp
include CyRK/cy/cysolve.hpp
include CyRK/cy/cy_array.cpp
include CyRK/cy/cy_array.hpp
include CyRK/cy/dense.cpp
include CyRK/cy/dense.hpp
include CyRK/cy/cysolution.cpp
include CyRK/cy/cysolution.hpp
include CyRK/cy/pysolver_cyhook.h
include CyRK/cy/pysolver_cyhook_api.h

include CyRK/optimize/c_brentq.cpp
include CyRK/optimize/c_brentq.hpp

include CyRK/nb/numba_c_api_.cpp

# Exclude the whole Tests folder (and the other developer-only directories).
prune Tests
prune Demos
prune Benchmarks
prune Documentation
prune Performance
